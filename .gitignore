# Create .gitignore file
cat > .gitignore << EOL
# Python
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.env
*.egg-info/
dist/
build/

# Data files (don't commit large data)
data/processed/
data/raw/
*.ifc
*.pdf
*.xlsx
*.xls

# VS Code
.vscode/
*.code-workspace

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
EOL